{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wirescript",
  "scopeName": "source.wirescript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#nested-prefab" },
    { "include": "#asset-reference" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.line.double-slash.wirescript",
          "match": "//.*$"
        }
      ]
    },
    "block-comment": {
      "comment": "Block comments nest, matching the reference lexer.",
      "name": "comment.block.wirescript",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wirescript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wirescript",
              "match": "\\\\[nrt\"\\\\$0]"
            },
            {
              "name": "meta.embedded.expression.wirescript",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.wirescript" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.wirescript" } },
              "patterns": [{ "include": "source.wirescript" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.wirescript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.wirescript",
              "match": "\\\\[nrt'\\\\$]"
            },
            {
              "name": "meta.embedded.expression.wirescript",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.wirescript" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.wirescript" } },
              "patterns": [{ "include": "source.wirescript" }]
            }
          ]
        }
      ]
    },
    "nested-prefab": {
      "patterns": [
        {
          "comment": "Inline nested-prefab block: $```<wirescript source>``` — the inner source is highlighted as wirescript (self-embedded grammar).",
          "name": "meta.embedded.block.wirescript",
          "begin": "\\$```",
          "end": "```",
          "beginCaptures": { "0": { "name": "punctuation.definition.nested.begin.wirescript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.nested.end.wirescript" } },
          "patterns": [{ "include": "source.wirescript" }]
        }
      ]
    },
    "asset-reference": {
      "patterns": [
        {
          "comment": "Prefab file reference: $./rel/path.brz or $/abs/path.brz",
          "name": "meta.reference.prefab.wirescript",
          "match": "(\\$)(\\.?/[A-Za-z0-9_./-]+)",
          "captures": {
            "1": { "name": "punctuation.definition.asset.wirescript" },
            "2": { "name": "string.other.path.prefab.wirescript" }
          }
        },
        {
          "comment": "External asset reference: $AssetType/AssetName",
          "name": "meta.reference.asset.wirescript",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_.-]*)(/)([A-Za-z0-9_./-]+)",
          "captures": {
            "1": { "name": "punctuation.definition.asset.wirescript" },
            "2": { "name": "entity.name.namespace.asset.wirescript" },
            "3": { "name": "punctuation.separator.asset.wirescript" },
            "4": { "name": "entity.name.asset.wirescript" }
          }
        },
        {
          "comment": "Bare asset reference without a slash: $AssetName",
          "name": "meta.reference.asset.wirescript",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.asset.wirescript" },
            "2": { "name": "entity.name.asset.wirescript" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Atom literal `:name` — a compile-time int constant (xxHash64 of the name), so it colors as an integer. Names are kebab-case-capable (`:the-black`, matching the lexer). The negative look-behind mirrors the lexer's rule that a `:` after a value-completing token is a plain colon, so a type annotation (`x: T`, `x:T`), a string map key (`\"k\": v`), and a `):`/`]:`/`}:` never match.",
          "name": "constant.numeric.integer.wirescript",
          "match": "(?<![A-Za-z0-9_\")\\]}]):[A-Za-z_][A-Za-z0-9_-]*"
        },
        {
          "name": "constant.numeric.float.wirescript",
          "match": "\\b\\d+\\.\\d*\\b"
        },
        {
          "name": "constant.numeric.integer.wirescript",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.modifier.annotation.wirescript",
          "match": "@(left|right|top|bottom|label|color|material|closed|nofold|fold|layout|flat|invisible|sliced)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "`in` is contextual: the `for x in` iterator reads as control flow alongside `for`, while a port declaration `in name: type` stays a declaration like `let`. Must precede the general keyword rules so it wins the tie at `for`.",
          "match": "\\b(for)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.wirescript" },
            "2": { "name": "variable.other.wirescript" },
            "3": { "name": "keyword.control.wirescript" }
          }
        },
        {
          "name": "keyword.control.wirescript",
          "match": "\\b(as|await|break|else|emit|for|from|if|match|on|return|then)\\b"
        },
        {
          "comment": "`unsafe` is contextual: match only the marker position, so a name spelled `unsafe` stays unhighlighted",
          "name": "keyword.other.unsafe.wirescript",
          "match": "\\bunsafe(?=\\s+[A-Za-z_])"
        },
        {
          "comment": "`is` (the enum variant test) is contextual the same way: only the operator position, followed by the `Enum.Variant` path it tests against. Scoped as a control keyword so it colors like `as`, not like `==`",
          "name": "keyword.control.is.wirescript",
          "match": "\\bis(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.declaration.wirescript",
          "match": "\\b(array|buffer|chip|const|enum|fn|import|in|let|map|mod|out|ref|static|type|var)\\b"
        },
        {
          "name": "storage.modifier.wirescript",
          "match": "\\*(?=\\s*[a-zA-Z])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.wirescript",
          "match": "\\b(Component|any|bool|brick|character|color|controller|entity|exec|float|int|never|prefab|quat|rotator|string|teleport|vector|zone)\\b"
        },
        {
          "name": "entity.name.type.wirescript",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.wirescript",
          "match": "\\b(AddLocationRotation|AddVelocity|BitCount|CharacterOf|Color|ControllerOf|Cross|Deg2Rad|DisplayText|Distance|DistanceSq|Dot|Fmt|GetAim|GetAngularVelocity|GetLeaderboard|GetLinearVelocity|GetLocation|GetLocationRotation|GetRotation|GetTeam|GetVelocity|IncLeaderboard|InputReader|Magnitude|MagnitudeSq|Normalize|Rad2Deg|Random|RelativeTeleport|ScaleVec|SetAngularVelocity|SetGravityDirection|SetLeaderboard|SetLinearVelocity|SetLocation|SetLocationRotation|SetRotation|SetVelocity|SpawnPrefab|Sweep|Teleport|Vec|acos|acosh|asin|asinh|atan|atan2|atanh|cos|cosh|exp|ln|max|min|round|sign|sin|sinh|tanh)\\b"
        },
        {
          "name": "support.constant.event.wirescript",
          "match": "\\b(BrickChanged|BrickRemoved|CharacterDamaged|CharacterDied|CharacterFiredWeapon|CharacterSpawned|ChatCommand|Clock|ControllerJoined|ControllerJoinedTeam|ControllerLeft|ControllerLeftTeam|CustomEvent|EntityZoneEntered|EntityZoneLeft|GlobalCustomEvent|Loaded|ProjectileZoneEntered|ProjectileZoneLeft|RoundEnd|RoundStart|WholeGridInteracted|WholeGridTargeted|ZoneEntered|ZoneLeft)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.wirescript",
          "match": "\\b(false|null|true)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wirescript",
          "match": "(&&|\\|\\||==|!=|<=|>=|\\.\\.|\\.prev|\\.Value|->|[+\\-*/<>!&|^~%]|=)"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.wirescript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.wirescript" } }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.wirescript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
