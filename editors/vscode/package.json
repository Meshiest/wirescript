{
  "name": "brickadia-wirescript",
  "displayName": "Brickadia Wirescript",
  "description": "Language support for Wirescript, a language that compiles to Brickadia's logic gates: errors as you type, completion, hover, formatting and one-key compile to a .brz",
  "version": "0.1.1",
  "publisher": "brickadia-community",
  "icon": "icon.png",
  "license": "CC0-1.0",
  "pricing": "Free",
  "homepage": "https://wirescript.brickadia.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meshiest/wirescript.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/Meshiest/wirescript/issues"
  },
  "keywords": [
    "brickadia",
    "wirescript",
    "logic",
    "logic gates",
    "gates",
    "circuits",
    "wires",
    "microchip",
    "components",
    "game",
    "modding",
    "scripting",
    "brz",
    "compiler",
    "language server"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:wirescript",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wirescript",
        "aliases": [
          "Wirescript",
          "ws"
        ],
        "extensions": [
          ".ws"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/wirescript-file-light.svg",
          "dark": "./media/wirescript-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "wirescript",
        "scopeName": "source.wirescript",
        "path": "./syntaxes/wirescript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "wirescript.compileAndCopy",
        "title": "Wirescript: Compile and Copy Path"
      },
      {
        "command": "wirescript.restartServer",
        "title": "Wirescript: Restart Language Server"
      },
      {
        "command": "wirescript.openDocs",
        "title": "Wirescript: Open Documentation"
      },
      {
        "command": "wirescript.openDocsPage",
        "title": "Wirescript: Open Documentation Page"
      }
    ],
    "keybindings": [
      {
        "command": "wirescript.compileAndCopy",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == wirescript"
      }
    ],
    "configuration": {
      "title": "Wirescript",
      "properties": {
        "wirescript.server": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "wasi"
          ],
          "enumDescriptions": [
            "Native when wirescript.lspPath is set or this checkout has a release build, WASI otherwise.",
            "The native wirescript-lsp binary.",
            "The WASI build (wasm32-wasip1-threads), run by the WebAssembly Execution Engine."
          ],
          "default": "auto",
          "description": "Which language server to run."
        },
        "wirescript.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to a native wirescript-lsp binary. Empty: this checkout's target/release build."
        },
        "wirescript.wasmPath": {
          "type": "string",
          "default": "",
          "description": "Path to a WASI wirescript-lsp.wasm. Empty: this checkout's target/wasm32-wasip1-threads/release build, else the bundled server."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "wirescript.openDocsPage",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "wirescript.docs",
          "name": "Wirescript Docs"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./docs/assets/learn.css",
      "./media/markdown-preview.css"
    ],
    "markdown.previewScripts": [
      "./docs/assets/learn-preview.js",
      "./media/markdown-preview.js"
    ]
  },
  "scripts": {
    "build": "node scripts/copy-docs.mjs && tsc -p . && node scripts/bundle.mjs",
    "vscode:prepublish": "npm run build",
    "test": "tsc -p . && node --test out/clipboard.test.js out/wasmMemory.test.js out/docsIndex.test.js out/markdownPreview.test.js out/bufferStream.test.js out/wasiPaths.test.js out/docLinks.test.js"
  },
  "dependencies": {
    "@vscode/wasm-wasi": "1.0.2",
    "@vscode/wasm-wasi-lsp": "0.1.0-pre.9",
    "vscode-languageclient": "10.0.0-next.21",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.24.2",
    "typescript": "^5.0.0"
  }
}
